import { useState, useEffect } from 'react';
import { 
  Plus, 
  Search, 
  Filter, 
  Link as LinkIcon,
  Copy,
  ExternalLink,
  TrendingUp,
  Wallet,
  Mail,
  Info
} from 'lucide-react';
import { useSettingsStore } from '@/stores/settingsStore';
import { useAuthStore } from '@/stores/authStore';
import { useUIStore } from '@/stores/uiStore';

export const PaymentsView = () => {
  const { activeMembership } = useAuthStore();
  const { updateSettings, paypalEmail: savedPaypalEmail, commercial } = useSettingsStore();
  const { addToast } = useUIStore();
  
  const currencyCode = commercial?.currency || 'USD';
  const currencySymbol = currencyCode === 'CRC' ? '₡' : '$';
  
  const [activeTab, setActiveTab] = useState<'links' | 'history'>('links');
  const [paypalEmail, setPaypalEmail] = useState(savedPaypalEmail || '');
  const [isSaving, setIsSaving] = useState(false);

  // Sincronizar estado local cuando carguen los ajustes
  useEffect(() => {
    if (savedPaypalEmail) {
      setPaypalEmail(savedPaypalEmail);
    }
  }, [savedPaypalEmail]);

  const handleSavePaypal = async () => {
    if (!activeMembership?.tenantId) return;
    setIsSaving(true);
    try {
      await updateSettings(activeMembership.tenantId, { paypalEmail });
      addToast('Configuración de PayPal actualizada', 'success');
    } catch (error) {
      addToast('Error al guardar configuración', 'error');
    } finally {
      setIsSaving(false);
    }
  };

  const stats = [
    { label: 'Recaudado (Mes)', value: `${currencySymbol} 142,500.00`, icon: TrendingUp, color: 'text-emerald-600', bg: 'bg-emerald-50' },
    { label: 'Links Activos', value: '12', icon: LinkIcon, color: 'text-blue-600', bg: 'bg-blue-50' },
    { label: 'Pendiente de Cobro', value: `${currencySymbol} 28,400.00`, icon: Wallet, color: 'text-amber-600', bg: 'bg-amber-50' },
  ];

  const paymentLinks = [
    { id: '1', customer: 'Juan Pérez', concept: 'Anticipo Instalación Solar', amount: 15000, status: 'pending', date: 'Hace 2 horas' },
    { id: '2', customer: 'Empresa ABC', concept: 'Mantenimiento Trimestral', amount: 2500, status: 'paid', date: 'Ayer' },
    { id: '3', customer: 'Maria Garcia', concept: 'Paquete Residencial Pro', amount: 85000, status: 'expired', date: 'Hace 3 días' },
  ];

  return (
    <div className="space-y-6">
      <div className="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h1 className="text-3xl font-black text-slate-900 dark:text-white tracking-tight">Links de Pago Nativos</h1>
          <p className="text-sm font-medium text-slate-500 dark:text-slate-400">Cobra a tus clientes directamente desde WhatsApp de forma segura.</p>
        </div>
        <button className="bg-[#1877F2] hover:bg-primary-700 text-white font-black text-xs uppercase tracking-widest px-8 py-4 rounded-2xl transition-all shadow-xl shadow-primary-600/20 active:scale-95 flex items-center gap-2">
          <Plus className="w-5 h-5" />
          Nuevo Link de Pago
        </button>
      </div>

      {/* Configuración de PayPal */}
      <div className="bg-white dark:bg-slate-800 rounded-[2.5rem] border border-slate-200 dark:border-slate-700 shadow-sm overflow-hidden animate-in fade-in slide-in-from-top-4 duration-500">
        <div className="grid grid-cols-1 lg:grid-cols-2">
          <div className="p-8 border-r border-slate-100 dark:border-slate-700">
            <div className="flex items-center gap-4 mb-8">
              <div className="p-3 bg-blue-50 dark:bg-blue-900/20 rounded-2xl text-blue-600">
                <Wallet className="w-6 h-6" />
              </div>
              <div>
                <h3 className="font-black text-slate-900 dark:text-white text-lg">Configuración de Cobros</h3>
                <p className="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Recibe tus pagos en tu cuenta PayPal</p>
              </div>
            </div>

            <div className="space-y-6">
              <div className="space-y-1.5">
                <label className="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1">Email de tu cuenta PayPal Business</label>
                <div className="relative">
                  <Mail className="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" />
                  <input 
                    type="email" 
                    placeholder="ejemplo@paypal.com" 
                    value={paypalEmail}
                    onChange={(e) => setPaypalEmail(e.target.value)}
                    className="w-full pl-11 pr-4 py-4 bg-slate-50 dark:bg-slate-900 border-2 border-transparent focus:border-primary-500/20 focus:bg-white rounded-2xl outline-none transition-all font-medium text-slate-900 dark:text-white"
                  />
                </div>
                <p className="text-[9px] text-slate-400 font-medium ml-1">Aquí es donde recibirás el dinero de tus clientes de forma inmediata.</p>
              </div>
              <button 
                onClick={handleSavePaypal}
                disabled={isSaving}
                className="w-full bg-slate-900 dark:bg-white text-white dark:text-slate-900 py-4 rounded-2xl font-black text-xs uppercase tracking-widest transition-all hover:scale-[1.01] active:scale-[0.98] disabled:opacity-50 shadow-lg shadow-slate-900/10"
              >
                {isSaving ? 'Guardando...' : 'Vincular Cuenta PayPal'}
              </button>
            </div>
          </div>

          <div className="p-8 bg-slate-50/50 dark:bg-slate-900/30">
            <div className="flex items-center gap-2 mb-4 text-blue-600 dark:text-blue-400">
              <Info className="w-4 h-4" />
              <h4 className="font-black text-xs uppercase tracking-widest">¿Cómo funciona?</h4>
            </div>
            <div className="space-y-5">
              <p className="text-xs text-slate-500 dark:text-slate-400 leading-relaxed font-medium">
                Al vincular tu email, el sistema generará automáticamente botones de pago profesionales. El dinero va directo a tu saldo de PayPal.
              </p>
              <div className="grid grid-cols-1 gap-3">
                <div className="flex items-start gap-4 bg-white dark:bg-slate-800 p-4 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm">
                  <div className="w-7 h-7 rounded-lg bg-blue-100 dark:bg-blue-900/30 text-blue-600 flex items-center justify-center text-xs font-black shrink-0">1</div>
                  <p className="text-[11px] font-bold text-slate-600 dark:text-slate-300">Entra a PayPal.com y asegúrate de que tu cuenta sea de tipo "Business" o "Negocios".</p>
                </div>
                <div className="flex items-start gap-4 bg-white dark:bg-slate-800 p-4 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm">
                  <div className="w-7 h-7 rounded-lg bg-blue-100 dark:bg-blue-900/30 text-blue-600 flex items-center justify-center text-xs font-black shrink-0">2</div>
                  <p className="text-[11px] font-bold text-slate-600 dark:text-slate-300">Confirma tu correo electrónico y vincula una cuenta bancaria para retirar tus fondos.</p>
                </div>
              </div>
              <div className="pt-2">
                <a 
                  href="https://www.paypal.com/bizsignup/" 
                  target="_blank" 
                  rel="noopener noreferrer"
                  className="flex items-center justify-center gap-2 bg-white dark:bg-slate-800 border-2 border-blue-500/20 text-blue-600 dark:text-blue-400 py-3 rounded-xl font-black text-[10px] uppercase tracking-[0.2em] hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-all"
                >
                  Abrir cuenta PayPal Business <ExternalLink className="w-3.5 h-3.5" />
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
        {stats.map((stat, idx) => (
          <div key={idx} className="bg-white dark:bg-slate-800 p-6 rounded-[2rem] border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md transition-all">
            <div className="flex items-center gap-5">
              <div className={`p-4 rounded-2xl ${stat.bg} ${stat.color} shadow-sm`}>
                <stat.icon className="w-7 h-7" />
              </div>
              <div>
                <p className="text-xs font-bold text-slate-400 uppercase tracking-widest mb-1">{stat.label}</p>
                <p className="text-2xl font-black text-slate-900 dark:text-white">{stat.value}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div className="bg-white dark:bg-slate-800 rounded-[2.5rem] border border-slate-200 dark:border-slate-700 shadow-sm overflow-hidden">
        <div className="p-8 border-b border-slate-200 dark:border-slate-700 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
          <div className="flex bg-slate-100 dark:bg-slate-900 p-1.5 rounded-2xl">
            <button 
              onClick={() => setActiveTab('links')}
              className={`px-6 py-2.5 rounded-xl text-xs font-black uppercase tracking-widest transition-all ${activeTab === 'links' ? 'bg-white dark:bg-slate-800 text-[#1877F2] shadow-sm' : 'text-slate-400 hover:text-slate-600'}`}
            >
              Links Activos
            </button>
            <button 
              onClick={() => setActiveTab('history')}
              className={`px-6 py-2.5 rounded-xl text-xs font-black uppercase tracking-widest transition-all ${activeTab === 'history' ? 'bg-white dark:bg-slate-800 text-[#1877F2] shadow-sm' : 'text-slate-400 hover:text-slate-600'}`}
            >
              Historial
            </button>
          </div>
          <div className="flex items-center gap-3">
            <div className="relative">
              <Search className="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" />
              <input 
                type="text" 
                placeholder="Buscar por cliente o concepto..." 
                className="pl-11 pr-4 py-3 bg-slate-50 dark:bg-slate-900 border-2 border-transparent focus:border-primary-500/20 focus:bg-white rounded-2xl text-sm font-medium outline-none transition-all w-full sm:w-80"
              />
            </div>
            <button className="p-3 bg-slate-50 dark:bg-slate-900 text-slate-400 rounded-2xl hover:text-[#1877F2] transition-colors">
              <Filter className="w-5 h-5" />
            </button>
          </div>
        </div>

        <div className="overflow-x-auto">
          <table className="w-full text-left border-collapse">
            <thead>
              <tr className="bg-slate-50/50 dark:bg-slate-900/50">
                <th className="px-8 py-5 text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Cliente / Concepto</th>
                <th className="px-8 py-5 text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Monto</th>
                <th className="px-8 py-5 text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Estado</th>
                <th className="px-8 py-5 text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Fecha</th>
                <th className="px-8 py-5 text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]"></th>
              </tr>
            </thead>
            <tbody className="divide-y divide-slate-100 dark:divide-slate-700">
              {paymentLinks.map((link) => (
                <tr key={link.id} className="hover:bg-slate-50/50 dark:hover:bg-slate-900/30 transition-colors group">
                  <td className="px-8 py-6">
                    <div className="flex items-center gap-4">
                      <div className="w-12 h-12 rounded-2xl bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 flex items-center justify-center text-[#1877F2] font-black shadow-sm group-hover:scale-110 transition-transform">
                        {link.customer.charAt(0)}
                      </div>
                      <div className="min-w-0">
                        <p className="font-black text-slate-900 dark:text-white truncate">{link.customer}</p>
                        <p className="text-[10px] font-bold text-slate-400 truncate uppercase tracking-tight">{link.concept}</p>
                      </div>
                    </div>
                  </td>
                  <td className="px-8 py-6">
                    <p className="text-lg font-black text-slate-900 dark:text-white tracking-tight">{currencySymbol} {link.amount.toLocaleString()}</p>
                  </td>
                  <td className="px-8 py-6">
                    <span className={`inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-[9px] font-black uppercase tracking-widest ${
                      link.status === 'paid' ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400' :
                      link.status === 'pending' ? 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400' :
                      'bg-slate-100 text-slate-700 dark:bg-slate-900 dark:text-slate-400'
                    }`}>
                      <div className={`w-1.5 h-1.5 rounded-full ${link.status === 'paid' ? 'bg-emerald-500' : link.status === 'pending' ? 'bg-amber-500' : 'bg-slate-400'}`} />
                      {link.status === 'paid' ? 'Pagado' : link.status === 'pending' ? 'Pendiente' : 'Expirado'}
                    </span>
                  </td>
                  <td className="px-8 py-6">
                    <p className="text-[11px] font-bold text-slate-400 uppercase">{link.date}</p>
                  </td>
                  <td className="px-8 py-6 text-right">
                    <div className="flex items-center justify-end gap-3 opacity-0 group-hover:opacity-100 transition-all translate-x-4 group-hover:translate-x-0">
                      <button className="p-3 bg-white dark:bg-slate-800 text-slate-400 rounded-2xl hover:bg-[#1877F2] hover:text-white transition-all shadow-sm border border-slate-100 dark:border-slate-700" title="Copiar Link">
                        <Copy className="w-4.5 h-4.5" />
                      </button>
                      <button className="p-3 bg-white dark:bg-slate-800 text-slate-400 rounded-2xl hover:bg-[#1877F2] hover:text-white transition-all shadow-sm border border-slate-100 dark:border-slate-700" title="Ver Detalle">
                        <ExternalLink className="w-4.5 h-4.5" />
                      </button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
};
