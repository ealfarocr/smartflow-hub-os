rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Función para obtener la membresía del usuario actual en un tenant específico
    // Se asume que el ID de la membresía es {uid}_{tenantId} para usuarios activos
    function getMembership(tenantId) {
      return get(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + tenantId)).data;
    }

    // P0 SEGURIDAD: antes solo verificaba exists() — una membership 'suspended'
    // (o cualquier otro status que no sea 'active') seguía contando como
    // miembro pleno del tenant. Ahora exige status=='active' explícitamente.
    // Si el doc no existe, getMembership() falla al leer .data y la regla
    // deniega (comportamiento estándar de Firestore Rules), así que no hace
    // falta un exists() aparte.
    function isTenantMember(tenantId) {
      return isAuthenticated() && getMembership(tenantId).status == 'active';
    }

    function getRole(tenantId) {
      return getMembership(tenantId).role;
    }

    function isAtLeast(tenantId, requiredRole) {
      let role = getRole(tenantId);

      // Mapeo manual de jerarquía simple
      let rIdx = role == 'Owner' ? 4 : (role == 'Admin' ? 3 : (role == 'Asesor Comercial' ? 2 : (role == 'Técnico' ? 1 : 0)));
      let qIdx = requiredRole == 'Owner' ? 4 : (requiredRole == 'Admin' ? 3 : (requiredRole == 'Asesor Comercial' ? 2 : (requiredRole == 'Técnico' ? 1 : 0)));

      return rIdx >= qIdx;
    }

    // P0 SEGURIDAD: ahora pasa por isTenantMember() primero, así que hereda
    // automáticamente la exigencia de status=='active' — un Admin/Owner
    // suspendido deja de contar como isTenantAdmin en todas partes sin tener
    // que tocar cada colección una por una.
    function isTenantAdmin(tenantId) {
      return isTenantMember(tenantId) && isAtLeast(tenantId, 'Admin');
    }

    // Super Admin: tiene isSuperAdmin == true en su documento /users/{uid}
    // Agregamos UID y Email como fallbacks para asegurar acceso total al creador
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.uid == 'qsiEuc1lBWUOkjUQRiYvsRf3Syn2' ||
        request.auth.token.email == 'publicidadynegociosenlinea@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true
      );
    }

    match /memberships/{membershipId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.email == request.auth.token.email ||
        isTenantAdmin(resource.data.tenantId) ||
        isSuperAdmin()
      );
      // Un usuario autenticado puede crear su propia membresía como Owner
      // SOLO como bootstrap de un tenant que ÉL MISMO acaba de crear
      // (OnboardingService.registerNewBusiness crea tenants/{tenantId} con
      // createdBy=uid en el paso anterior, y recién ahí se autoasigna Owner).
      // P0 SEGURIDAD: antes esta rama no verificaba nada sobre el tenant —
      // cualquier autenticado podía autoasignarse Owner en CUALQUIER tenant
      // EXISTENTE (memberships/{miUid}_{tenantIdAjeno} nunca existía antes,
      // así que caía en 'create', no en 'update', y pasaba igual). Ahora se
      // exige que el tenant ya exista y que su createdBy sea este mismo uid
      // — imposible de falsificar, porque createdBy solo lo pone el propio
      // flujo de creación de tenants y nunca se puede reescribir después
      // (tenants update ya exige isTenantAdmin).
      allow create: if isAuthenticated() && (
        (
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.role == 'Owner' &&
          request.resource.data.status == 'active' &&
          membershipId == request.auth.uid + '_' + request.resource.data.tenantId &&
          get(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId)).data.createdBy == request.auth.uid
        ) ||
        isTenantAdmin(request.resource.data.tenantId) ||
        isSuperAdmin()
      );
      // P0 SEGURIDAD: la versión anterior evaluaba
      // isTenantAdmin(request.resource.data.tenantId || resource.data.tenantId)
      // — como request.resource.data.tenantId (el valor ENVIADO por quien
      // escribe) siempre es verdadero cuando está presente, un Admin del
      // tenant A podía actualizar una membership que en realidad pertenece
      // al tenant B con solo mandar tenantId:'A' en el payload: la regla
      // comprobaba su autoridad sobre A (donde sí es Admin), nunca sobre B
      // (el tenant real del documento). Ahora la autoridad se valida SIEMPRE
      // contra resource.data.tenantId (el valor ya guardado, no falsificable
      // por quien escribe) y además se exige que tenantId no cambie en el
      // update — así un documento nunca puede "migrar" de tenant.
      allow update: if (
        isTenantAdmin(resource.data.tenantId) &&
        request.resource.data.tenantId == resource.data.tenantId
      ) || isSuperAdmin();
      allow delete: if isTenantAdmin(resource.data.tenantId) || isSuperAdmin();
    }

    match /users/{userId} {
      // Endurecido: un usuario solo puede leer su propio perfil; SuperAdmin puede leer cualquiera.
      // Antes: cualquier usuario autenticado podía leer todos los perfiles (PII expuesta).
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());

      // P0 SEGURIDAD: la regla anterior (`allow write: if uid==userId ||
      // isSuperAdmin()`) dejaba que cualquier usuario escribiera CUALQUIER
      // campo de su propio documento, incluido isSuperAdmin — un
      // setDoc(doc(db,'users',miUid), {isSuperAdmin:true}, {merge:true})
      // alcanzaba para volverse SuperAdmin de toda la plataforma. Ahora se
      // exige explícitamente que isSuperAdmin nunca cambie por esta vía
      // (ni aparecer en true al crear el perfil, ni modificarse al
      // actualizarlo) — .get(key, default) evita error si el campo no existe
      // todavía en el documento.
      allow create: if isAuthenticated() && request.auth.uid == userId &&
        request.resource.data.get('isSuperAdmin', false) == false;
      allow update: if isAuthenticated() && request.auth.uid == userId &&
        request.resource.data.get('isSuperAdmin', false) == resource.data.get('isSuperAdmin', false);
      allow write: if isSuperAdmin();
    }

    match /tenants/{tenantId} {
      // Endurecido: lectura solo a miembros del tenant o SuperAdmin.
      // Antes: cualquiera con `request.query.limit <= 5` podía leer datos de tenants (incluye ownerEmail).
      // La verificación de disponibilidad de nombre debe migrar a una Cloud Function.
      allow read: if isTenantMember(tenantId) || isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isTenantAdmin(tenantId) || isSuperAdmin();
    }

    match /available_tools/{toolId} {
      allow read: if true; // Público para el Checkout/Marketplace
      allow write: if isSuperAdmin();
    }

    match /leads/{leadId} {
      allow read: if isTenantMember(resource.data.tenantId) || isSuperAdmin();
      allow create: if isTenantMember(request.resource.data.tenantId) || isSuperAdmin();
      allow update: if isTenantMember(resource.data.tenantId) || isSuperAdmin();
      allow delete: if isTenantAdmin(resource.data.tenantId) || isSuperAdmin();
    }

    match /quotes/{quoteId} {
      allow read: if isSuperAdmin() || isTenantMember(resource.data.tenantId);
      allow create: if isSuperAdmin() || isTenantMember(request.resource.data.tenantId);
      allow update: if isSuperAdmin() || isTenantMember(resource.data.tenantId);
      allow delete: if isSuperAdmin() || isTenantAdmin(resource.data.tenantId);
    }

    match /settings/{docId} {
      allow read: if isTenantMember(docId) || isSuperAdmin() || 
        (isAuthenticated() && exists(/databases/$(database)/documents/tenants/$(docId)) && 
         get(/databases/$(database)/documents/tenants/$(docId)).data.createdBy == request.auth.uid);
      allow write: if isTenantAdmin(docId) || isSuperAdmin() ||
        (isAuthenticated() &&
          exists(/databases/$(database)/documents/tenants/$(docId)) &&
          get(/databases/$(database)/documents/tenants/$(docId)).data.createdBy == request.auth.uid);
    }
    
    match /packages/{pkgId} {
      // P1 SEGURIDAD: "isTenantAdmin(request.resource.data.tenantId || resource.data.tenantId)"
      // evaluaba el tenantId PROPUESTO por el cliente antes que el del doc
      // existente — un admin del Tenant B podía update/delete un package del
      // Tenant A con solo mandar tenantId:B en el payload. Ahora update/delete
      // se autorizan SIEMPRE contra resource.data.tenantId (el dueño real), y
      // tenantId queda inmutable en update.
      allow read: if isTenantMember(resource.data.tenantId) || isSuperAdmin();
      allow create: if isTenantAdmin(request.resource.data.tenantId) || isSuperAdmin();
      allow update: if (
        isTenantAdmin(resource.data.tenantId) &&
        request.resource.data.tenantId == resource.data.tenantId
      ) || isSuperAdmin();
      allow delete: if isTenantAdmin(resource.data.tenantId) || isSuperAdmin();
    }

    match /catalog/{itemId} {
      // P1 SEGURIDAD: "isTenantMember(resource.data.tenantId) || isTenantMember(request.resource.data.tenantId)"
      // dejaba que CUALQUIER miembro (no solo admin) de un tenant ajeno se
      // "adueñara" de un item de catálogo con solo mandar su propio tenantId
      // en el update — la membresía en el tenant RECLAMADO alcanzaba. Ahora
      // update se autoriza solo contra el tenantId real del doc, y ese campo
      // queda inmutable.
      // El catálogo es el PRODUCTO MAESTRO del negocio: cualquier miembro
      // activo puede LEERLO (el asesor lo consulta desde la conversación para
      // elegir un producto y mandárselo al cliente), pero crear, editar o
      // borrar productos es de Owner/Admin. Antes create/update/delete pedían
      // solo isTenantMember, así que un asesor podía alterar el catálogo del
      // negocio saltándose la UI.
      allow read: if isSuperAdmin() || isTenantMember(resource.data.tenantId);
      allow create: if isSuperAdmin() || isTenantAdmin(request.resource.data.tenantId);
      allow update: if isSuperAdmin() || (
        isTenantAdmin(resource.data.tenantId) &&
        request.resource.data.tenantId == resource.data.tenantId
      );
      allow delete: if isSuperAdmin() || isTenantAdmin(resource.data.tenantId);
    }
    
    match /agenda_items/{itemId} {
      allow read: if isSuperAdmin() || isTenantMember(resource.data.tenantId);
      allow create: if isSuperAdmin() || isTenantMember(request.resource.data.tenantId);
      allow update: if isSuperAdmin() || isTenantMember(resource.data.tenantId);
      allow delete: if isSuperAdmin() || isTenantMember(resource.data.tenantId);
    }

    // Notificaciones in-app. Las crea el backend (Admin SDK bypasea reglas);
    // los miembros del tenant pueden leerlas y marcarlas como leídas.
    match /notifications/{notifId} {
      allow read: if isSuperAdmin() || isTenantMember(resource.data.tenantId);
      allow update, delete: if isSuperAdmin() || isTenantMember(resource.data.tenantId);
      allow create: if isSuperAdmin() || isTenantMember(request.resource.data.tenantId);
    }

    // Configuración global (base del Agente IA que aplica a todos los negocios).
    // Cualquier usuario autenticado la puede LEER (los agentes la heredan); solo el
    // SuperAdmin la puede EDITAR. Los negocios nunca la modifican.
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    match /conversations/{conversationId} {
      allow read, update: if isTenantMember(resource.data.tenantId) || isSuperAdmin();
      allow create: if isTenantMember(request.resource.data.tenantId) || isSuperAdmin();

      match /messages/{messageId} {
        allow read, write: if isTenantMember(get(/databases/$(database)/documents/conversations/$(conversationId)).data.tenantId) || isSuperAdmin();
      }
    }
    
    match /integrations/{integrationId} {
      // BUG REAL encontrado por el canary de Embedded Signup (LOOP Fase 9):
      // "resource.data.tenantId || request.resource.data.tenantId" no es un
      // "usar resource, si no existe usar request" al estilo JS — el operador
      // || de Firestore Rules exige booleanos en AMBOS lados. Con
      // resource.data.tenantId siendo un STRING no vacío, esto tira un error
      // de tipo ("Received: [string] Expected: [bool]") y Firestore trata
      // cualquier error de evaluación de regla como DENY — sin importar el
      // rol. Confirmado con el emulador real: rompía el read/delete para
      // TODO usuario (Owner, Admin, e incluso SuperAdmin, porque el error
      // aborta la expresión completa antes de llegar al || isSuperAdmin()),
      // sobre CUALQUIER doc existente. Para read/delete, resource SIEMPRE
      // existe (no se puede leer/borrar lo que no existe) — el fallback a
      // request nunca hacía falta ahí, solo en create.
      allow read, delete: if isTenantAdmin(resource.data.tenantId) || isSuperAdmin();
      allow create: if isTenantAdmin(request.resource.data.tenantId) || isSuperAdmin();
      allow update: if (
        isTenantAdmin(resource.data.tenantId) &&
        request.resource.data.tenantId == resource.data.tenantId
      ) || isSuperAdmin();
    }

    // Conexiones de marketing (Facebook Page Access Token, Instagram Business, Blog).
    // Doc ID == tenantId. Solo Admin/Owner del tenant o SuperAdmin pueden leer/escribir.
    // Antes estaba en settings/{tenantId}.marketingConnections, donde cualquier miembro
    // (incluidos Asesor Comercial y Técnico) podía leer los Page Access Tokens.
    match /marketing_connections/{tenantId} {
      allow read, write: if isTenantAdmin(tenantId) || isSuperAdmin();
    }

    // P0 SEGURIDAD: antes read/write eran "if isAuthenticated()" sin ningún
    // scope de tenant — cualquier autenticado podía leer collection('user_presence')
    // completa y obtener el tenantId + email + rol de TODOS los usuarios de
    // TODOS los tenants (la lista exacta de objetivos para un ataque de toma
    // de tenant). Doc ID real es `{tenantId}_{uid}` (ver PresenceService.ts)
    // y siempre se escribe con esos dos campos, así que se puede exigir que
    // coincidan.
    // LOOP Fase 10: la lectura se restringió más — ahora que el doc trae
    // operationalStatus (dónde/en qué pausa está cada vendedor AHORA), un
    // asesor cualquiera ya no puede leer la presencia del resto del equipo,
    // solo la propia; el panel de equipo (Owner/Admin) sigue viendo todo.
    //
    // CHECKPOINT DE SEGURIDAD (post-Bloque 5): operationalStatus/
    // operationalStatusChangedAt/activeWorkSessionId son SOLO del Admin SDK
    // (setOperationalStatus en functions/src/index.ts) — el cliente puede
    // seguir escribiendo su propio heartbeat de presencia TÉCNICA
    // (status online/idle/offline, lastSeenAt, currentRoute — eso ya estaba
    // bien y se conserva), pero el update() de create/update exige
    // explícitamente que esos 3 campos NO cambien vía escritura directa del
    // cliente (create: no pueden venir seteados; update: hasOnly excluye
    // los 3 de la lista de campos que el cliente puede tocar).
    match /user_presence/{presenceId} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        isTenantAdmin(resource.data.tenantId) ||
        isSuperAdmin()
      );
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.uid &&
        isTenantMember(request.resource.data.tenantId) &&
        !('operationalStatus' in request.resource.data) &&
        !('operationalStatusChangedAt' in request.resource.data) &&
        !('activeWorkSessionId' in request.resource.data);
      allow update: if isAuthenticated() &&
        request.auth.uid == resource.data.uid &&
        request.resource.data.tenantId == resource.data.tenantId &&
        isTenantMember(resource.data.tenantId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'lastSeenAt', 'lastActiveAt', 'currentRoute', 'authProvider', 'userAgent', 'updatedAt', 'email', 'displayName', 'role']);
    }

    // Sesiones de turno (LOOP Fase 9) — CHECKPOINT DE SEGURIDAD: ya NO es
    // self-write. startedAt/endedAt/activeSeconds/idleSeconds/status son
    // telemetría que decide el Owner/Admin (presencia y tiempo operativo del
    // equipo), así que un vendedor con acceso al navegador no puede
    // fabricarlos ni editarlos — solo setOperationalStatus/tickPresence
    // (Admin SDK) escriben acá.
    match /work_sessions/{sessionId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isTenantAdmin(resource.data.tenantId) ||
        isSuperAdmin()
      );
      allow write: if false;
    }

    // Log de cambios de estado operativo (LOOP Fase 9) — CHECKPOINT DE
    // SEGURIDAD: ya NO se crea desde el cliente. changedAt/fromStatus/
    // toStatus los escribe únicamente setOperationalStatus (Admin SDK),
    // dentro de la misma transacción que abre/cierra/actualiza el
    // work_session — así la línea de tiempo del día no se puede falsificar
    // ni queda inconsistente con la sesión.
    match /work_status_events/{eventId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isTenantAdmin(resource.data.tenantId) ||
        isSuperAdmin()
      );
      allow write: if false;
    }

    // Credenciales de PIN de vendedores (LOOP dispositivo confiable) —
    // NUNCA accesible desde el cliente, ni siquiera de lectura: el pinHash
    // salteado, el authUid técnico y el contador de intentos fallidos solo
    // los toca el Admin SDK de functions/src/index.ts (setVendorPin,
    // loginWithPin). Esto es intencional, no un placeholder por completar.
    match /vendor_credentials/{membershipId} {
      allow read, write: if false;
    }

    // Índice de resolución "tenantId + usuario visible (Michelle) -> PIN
    // login" (checkpoint de seguridad: el vendedor nunca ve/usa un
    // membershipId). Mismo criterio que vendor_credentials — inalcanzable
    // desde el cliente, solo loginWithPin/setVendorPin (Admin SDK) lo leen
    // o escriben. Si fuera legible, listar esta colección revelaría todos
    // los usuarios válidos de un tenant (enumeración).
    match /login_handles/{handleId} {
      allow read, write: if false;
    }

    // Dispositivos confiables (LOOP) — de lectura sí (para que el propio
    // vendedor vea "sus" dispositivos y el Owner/Admin vea los de su equipo),
    // pero de escritura NUNCA desde el cliente: todo pasa por registerDevice/
    // renameDevice/revokeDevice (Admin SDK) para que un cliente comprometido
    // no pueda auto-otorgarse confianza ni revivir un dispositivo revocado.
    match /trusted_devices/{deviceId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isTenantAdmin(resource.data.tenantId) ||
        isSuperAdmin()
      );
      allow write: if false;
    }

    match /tasks/{taskId} {
      allow read: if isSuperAdmin() || isTenantMember(resource.data.tenantId);
      allow create: if isSuperAdmin() || isTenantMember(request.resource.data.tenantId);
      allow update: if isSuperAdmin() || isTenantMember(resource.data.tenantId);
      allow delete: if isSuperAdmin() || isTenantMember(resource.data.tenantId);
    }

    match /payment_requests/{requestId} {
      // Privado — solo el tenant dueño y SuperAdmin. La página pública
      // /pay/{id} NUNCA lee esta colección directamente (requeriría
      // isAuthenticated(), que un cliente pagando jamás cumple) — lee
      // public_payment_links, el snapshot sanitizado de abajo.
      allow read: if isAuthenticated() && (isTenantMember(resource.data.tenantId) || isSuperAdmin());
      allow create: if isTenantMember(request.resource.data.tenantId) || isSuperAdmin();
      // status 'paid' se escribe por DOS vías:
      // 1) backend (verifyPaypalOrder/capturePaymentRequestPaypalOrder, Admin
      //    SDK, bypasea esta regla) tras confirmar el cobro real con PayPal.
      // 2) Owner/Admin del tenant confirmando manualmente un pago local
      //    (SINPE/transferencia) — ver bloque isTenantAdmin abajo. Un
      //    miembro cualquiera puede seguir administrando el link (archivar/
      //    expirar) pero nunca tocar 'paid' por la vía genérica, ni
      //    "despagar" uno ya confirmado (una vez paid, ninguna de las dos
      //    ramas de client-side vuelve a aceptar cambios).
      allow update: if isSuperAdmin() || (
        isTenantMember(resource.data.tenantId) &&
        request.resource.data.tenantId == resource.data.tenantId &&
        (
          (request.resource.data.status != 'paid' && resource.data.status != 'paid') ||
          (
            // Confirmación manual: solo Owner/Admin, solo pending -> paid,
            // sin tocar monto/moneda/identidad del link ni el usuario que
            // firma la confirmación.
            isTenantAdmin(resource.data.tenantId) &&
            resource.data.status == 'pending' &&
            request.resource.data.status == 'paid' &&
            request.resource.data.amount == resource.data.amount &&
            request.resource.data.currency == resource.data.currency &&
            request.resource.data.customer == resource.data.customer &&
            request.resource.data.concept == resource.data.concept &&
            request.resource.data.paymentMethod in ['sinpe', 'bank'] &&
            request.resource.data.paidBy == request.auth.uid
          )
        )
      );
      allow delete: if isTenantAdmin(resource.data.tenantId) || isSuperAdmin();
    }

    // Snapshot público y mínimo de un link de pago — lo único que la página
    // pública /pay/{id} puede leer sin autenticación. Se genera junto con
    // payment_requests (mismo ID, mismo batch, ver PaymentService.createRequest)
    // y NUNCA contiene el documento de settings completo del tenant ni
    // ningún token/accessToken — solo los campos de contacto de pago que el
    // asesor eligió incluir en ESE link puntual.
    match /public_payment_links/{linkId} {
      allow read: if true;
      allow create: if isTenantMember(request.resource.data.tenantId) || isSuperAdmin();
      // Mismo criterio que payment_requests: el tenant puede administrar el
      // link (expirarlo, etc.) pero 'paid' solo lo escribe el backend tras un
      // cobro real con PayPal, o Owner/Admin confirmando manualmente un pago
      // local — nunca el negocio por la vía genérica, y mucho menos el
      // pagador (que ni siquiera está autenticado).
      allow update: if isSuperAdmin() || (
        isTenantMember(resource.data.tenantId) &&
        request.resource.data.tenantId == resource.data.tenantId &&
        (
          (request.resource.data.status != 'paid' && resource.data.status != 'paid') ||
          (
            isTenantAdmin(resource.data.tenantId) &&
            resource.data.status == 'pending' &&
            request.resource.data.status == 'paid' &&
            request.resource.data.amount == resource.data.amount &&
            request.resource.data.currency == resource.data.currency &&
            request.resource.data.customer == resource.data.customer &&
            request.resource.data.concept == resource.data.concept
          )
        )
      );
      allow delete: if isTenantAdmin(resource.data.tenantId) || isSuperAdmin();
    }

    // P0 SEGURIDAD: "allow create: if isAuthenticated()" permitía a
    // cualquier autenticado escribir folder:'sent' + attachmentUrl arbitraria
    // — processOutboundEmail (Cloud Function, Admin SDK) toma cualquier doc
    // con folder=='sent' y lo manda de verdad por SendGrid desde el dominio
    // de SmartFlow, y además hace un fetch de attachmentUrl (SSRF con el
    // contenido devuelto al remitente). El único flujo legítimo del lado del
    // cliente es el widget de soporte in-app (SupportAgent.tsx), que SIEMPRE
    // escribe folder:'inbox' + type:'support_request' — nunca dispara un
    // envío real. Cualquier otra forma de crear un admin_email (incluido
    // folder:'sent') queda restringida a SuperAdmin; los flujos backend
    // legítimos (Cloud Functions) usan Admin SDK y no pasan por esta regla.
    match /admin_emails/{emailId} {
      allow read, update, delete: if isSuperAdmin();
      allow create: if isSuperAdmin() || (
        isAuthenticated() &&
        request.resource.data.folder == 'inbox' &&
        request.resource.data.type == 'support_request'
      );
    }

    match /landing_blog_posts/{postId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Colecciones internas — solo accesibles via Admin SDK (Cloud Functions).
    match /whatsapp_message_dedup/{wamid} {
      allow read, write: if false;
    }
    match /paypal_orders/{orderId} {
      allow read, write: if false;
    }
    match /tenant_onboarding_states/{tenantId} {
      allow read, write: if false;
    }

    // Bitácora de rescates de acceso (break-glass del SuperAdmin). La escribe
    // solo el Admin SDK; el SuperAdmin puede leerla para revisarla. Nunca
    // contiene códigos ni hashes.
    match /security_audit/{eventId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
  }
}
