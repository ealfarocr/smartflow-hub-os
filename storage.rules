rules_version = '2';

// Craft rules based on the provided requirements:
// - Authenticated users of the tenant can upload PDFs to quotes/{tenantId}/{fileName}
// - Reading must allow Meta to download the PDF via a downloadable URL (meaning public read for the quotes path, or standard token-based read which Firebase implicitly generates on getDownloadURL). 
// Wait, Meta uses the `downloadUrl` generated by Firebase SDK, which includes a persistent token `?alt=media&token=xyz`. Since the Firebase SDK client generates this token automatically during upload if it creates the file, or `getDownloadURL()` automatically uses it, we don't actually need to make it publicly readable to *everyone* without a token, but just to the person holding the token.
// Firebase Storage rules *do not* affect access via download token; they only restrict direct bucket access. However, for simplicity and alignment with standard web architectures that use token URLs, we should allow read access if authenticated or public read on that specific path. But actually, `getDownloadURL()` bypasses `storage.rules` when the token is appended. So we just need to ensure the worker can write.

service firebase.storage {
  match /b/{bucket}/o {
    
    // Función helper para tenant (si la data trae tenant)
    // Para storage, el upload no envía custom metadata automáticamente a menos que lo configuremos.
    // Requeriremos que estén logueados al menos.

    match /quotes/{tenantId}/{fileName} {
      // Permitir escribir si está autenticado. Para estricto tenant check, firebase auth uid y custom claims idealmente. 
      // Siendo MVP seguro, request.auth != null
      allow write: if request.auth != null;
      // Permitir lectura a cualquiera con la URL (aunque el token soluciona esto, dejémoslo accesible para Meta si lee el raw link)
      allow read: if true; 
    }

    match /logos/{tenantId}/{fileName} {
      // Solo imágenes, máximo 2MB
      allow write: if request.auth != null
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      // Lectura pública para renderizar en PDFs y branding
      allow read: if true;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
