rules_version = '2';

// Craft rules based on the provided requirements:
// - Authenticated users of the tenant can upload PDFs to quotes/{tenantId}/{fileName}
// - Reading must allow Meta to download the PDF via a downloadable URL (meaning public read for the quotes path, or standard token-based read which Firebase implicitly generates on getDownloadURL). 
// Wait, Meta uses the `downloadUrl` generated by Firebase SDK, which includes a persistent token `?alt=media&token=xyz`. Since the Firebase SDK client generates this token automatically during upload if it creates the file, or `getDownloadURL()` automatically uses it, we don't actually need to make it publicly readable to *everyone* without a token, but just to the person holding the token.
// Firebase Storage rules *do not* affect access via download token; they only restrict direct bucket access. However, for simplicity and alignment with standard web architectures that use token URLs, we should allow read access if authenticated or public read on that specific path. But actually, `getDownloadURL()` bypasses `storage.rules` when the token is appended. So we just need to ensure the worker can write.

service firebase.storage {
  match /b/{bucket}/o {

    // Cotizaciones PDF — solo usuarios autenticados, max 10MB, solo PDF.
    // Nota: las Storage Rules no permiten consultar Firestore para validar membresia
    // tenant a tenant. Por eso aqui solo se valida autenticacion + tipo MIME + tamano.
    // Aislamiento tenant-a-tenant se complementa a nivel de aplicacion (Cloud Functions
    // y Firestore) que controlan acceso a las URLs y referencias.
    // Los enlaces compartidos via getDownloadURL llevan token y bypasean estas reglas,
    // lo cual es el comportamiento esperado para enviar el PDF al cliente via WhatsApp.
    match /quotes/{tenantId}/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
      allow read: if request.auth != null;
    }

    // Logos — lectura publica (se usan en PDFs, branding y previews externos).
    match /logos/{tenantId}/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow read: if true;
    }

    // Catalogo de productos — lectura publica (cotizaciones, WhatsApp).
    match /catalog/{tenantId}/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow read: if true;
    }

    // Adjuntos admin — solo autenticados, max 10MB.
    match /admin_attachments/{fileName} {
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
      allow read: if request.auth != null;
    }

    // Documentos de entrenamiento del Agente IA — solo autenticados, max 5MB,
    // restringir tipos MIME comunes para evitar abuso de almacenamiento.
    match /tenants/{tenantId}/ai-agent/{type}/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && (
                        request.resource.contentType == 'application/pdf'
                     || request.resource.contentType == 'text/plain'
                     || request.resource.contentType == 'application/json'
                     || request.resource.contentType.matches('image/.*')
                   );
      allow read: if request.auth != null;
    }

    // Adjuntos de chat (asesor humano enviando archivos al cliente)
    match /chat-attachments/{tenantId}/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024;
      allow read: if true;
    }

    // Biblioteca de medios del Agente IA (archivos que el bot puede enviar)
    match /media-library/{tenantId}/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024;
      allow read: if true;
    }

    // Documentos GLOBALES del Agente IA (base común a todos los negocios).
    // Solo escritura autenticada (SuperAdmin validado a nivel de app); lectura pública.
    match /agent-global/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024;
      allow read: if true;
    }

    // Medios de WhatsApp entrantes (audio, imágenes) — solo escritura desde servidor (Admin SDK), lectura pública.
    match /whatsapp-media/{tenantId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
