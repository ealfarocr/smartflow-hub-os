# QA LOCAL DEL PUESTO DEL VENDEDOR — sin secretos, solo apunta a los emuladores
# de firebase.e2e.json. Se usa con: npx vite --mode qalocal --port 5174
# (ver scripts/qa_seller_seed.mjs). Nunca toca producción.
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_PROJECT_ID=smartflow-e2e
VITE_FIREBASE_STORAGE_BUCKET=smartflow-e2e.appspot.com
VITE_EMULATOR_AUTH_PORT=9098
VITE_EMULATOR_FIRESTORE_PORT=8085
VITE_EMULATOR_FUNCTIONS_PORT=5011
VITE_EMULATOR_STORAGE_PORT=9198
